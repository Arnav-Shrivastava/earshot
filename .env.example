# Copy to .env and fill in. Never commit .env.

# Postgres connection string for running apps outside Docker. The compose db is published on
# 127.0.0.1:5433 (change with EARSHOT_DB_PORT). Inside docker compose the host is set automatically.
DATABASE_URL=postgres://earshot:earshot@localhost:5433/earshot

# Used to encrypt stored secrets (your OpenAI key, connector tokens) with AES-256-GCM.
# Required, at least 32 characters. Generate one with: openssl rand -base64 32
# Losing this value makes stored secrets unrecoverable.
EARSHOT_SECRET=

# Public URL of the web app.
APP_URL=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
